@model WebApp.DAL.Entities.Order


<div class="bg-gray-800 text-white py-4 text-center sticky top-0 z-10 shadow-md">
    <div class="container mx-auto px-4 flex justify-between items-center">
        <span class="text-xl font-semibold">CRM - System vol 1.1</span>
        <a href="/" class="bg-gray-700 hover:bg-gray-800 text-white text-sm px-4 py-2 rounded transition duration-200">
            Home
        </a>
    </div>
</div>


<div class="container mx-auto mt-6 bg-white p-6 rounded-lg shadow-md max-w-md">
    <h2 class="text-2xl font-semibold mb-4">Создать заказ</h2>

    <form method="post" action="/Order/Save">
       
        <input type="hidden" name="Id" value="0" />

      
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Пользователь</label>
            <select name="UserId"
                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                    required>
                <option value="" disabled selected>Выберите пользователя</option>
                @foreach (var user in ViewBag.Users)
                {
                    <option value="@user.Id">@user.FullName</option>
                }
            </select>
        </div>

        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Цена</label>
            <input type="number"
                   name="Price"
                   class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                   placeholder="Введите сумму"
                   step="0.01"
                   required />
        </div>

   
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Дата</label>
            <input type="date"
                   name="Date"
                   class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                   required />
        </div>


        <div class="flex gap-2">
            <button type="submit"
                    class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded transition duration-200">
                Сохранить
            </button>
            <a href="/Order/Index"
               class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded transition duration-200">
                Отмена
            </a>
        </div>
    </form>
</div>