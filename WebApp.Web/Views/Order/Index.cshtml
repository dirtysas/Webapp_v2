@model List<WebApp.DAL.Entities.Order>

<div class="bg-gray-800 text-white py-4 text-center sticky top-0 z-10 shadow-md">
    <div class="container mx-auto px-4 flex justify-between items-center">
        <span class="text-xl font-semibold">CRM - System vol 1.1</span>
        <a href="/" class="bg-gray-700 hover:bg-gray-800 text-white text-sm px-4 py-2 rounded transition duration-200">
            Home
        </a>
    </div>
</div>

<div class="container mx-auto mt-6">
    <h2 class="text-2xl font-semibold mb-4">Заказы</h2>
    <a href="/Order/Create" class="inline-block bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition mb-4">
        Добавить новый
    </a>

    <div class="overflow-x-auto">
        <table class="min-w-full bg-white border border-gray-300 rounded-lg shadow-sm">
            <thead class="bg-gray-100">
                <tr>
                    <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Пользователь</th>
                    <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Цена</th>
                    <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Дата</th>
                    <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var order in Model)
                    {
                        <tr class="border-b hover:bg-gray-50">
                            <td class="px-4 py-2 text-sm">@order.User.FullName</td>
                            <td class="px-4 py-2 text-sm">@order.Price.ToString("C")</td>
                            <td class="px-4 py-2 text-sm">@order.Date.ToShortDateString()</td>
                            <td class="px-4 py-2 text-sm space-x-2">
                                <a href="/Order/Edit/@order.Id" class="text-blue-600 hover:underline">Редактировать</a>
                                <a href="/Order/Delete/@order.Id" class="text-red-600 hover:underline">Удалить</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="px-4 py-4 text-center text-gray-500">Нет заказов</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>