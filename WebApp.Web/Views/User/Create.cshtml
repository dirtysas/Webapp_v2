@model WebApp.DAL.Entities.User


<div class="bg-gray-800 text-white py-4 text-center sticky top-0 z-10 shadow-md">
    <div class="container mx-auto px-4 flex justify-between items-center">
        <span class="text-xl font-semibold">CRM - System vol 1.1</span>
        <a href="/" class="bg-gray-700 hover:bg-gray-800 text-white text-sm px-4 py-2 rounded transition duration-200">
            Home
        </a>
    </div>
</div>

<div class="container mx-auto mt-6 bg-white p-6 rounded-lg shadow-md max-w-md">
    <h2 class="text-2xl font-semibold mb-4">Создать пользователя</h2>
    <form method="post" action="/User/Save">
        <input type="hidden" name="Id" value="@Model?.Id ?? 0" />

        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">ФИО</label>
            <input type="text"
                   name="FullName"
                   class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                   value="@Model?.FullName"
                   required />
        </div>

        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Дата рождения</label>
            <input type="date"
                   name="BirthDate"
                   class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                   value="@(Model != null ? Model.BirthDate.ToString("yyyy-MM-dd") : "")"
                   required />
        </div>

        <div class="flex gap-2">
            <button type="submit"
                    class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded transition duration-200">
                Сохранить
            </button>
            <a href="/User/Index"
               class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded transition duration-200">
                Отмена
            </a>
        </div>
    </form>
</div>