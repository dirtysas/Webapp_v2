@model List<WebApp.DAL.Entities.User>

<!-- Серая полоса сверху -->
<div class="bg-gray-800 text-white py-3 text-center">
    <div class="container mx-auto px-4 flex justify-between items-center">
        <span>CRM - System vol 1.1</span>
        <a href="/" class="bg-gray-600 hover:bg-gray-800 text-white text-sm px-4 py-1 rounded transition">
            Home
        </a>
    </div>
</div>


<div class="container mx-auto p-6">
    <h2 class="text-2xl font-semibold mb-4">Пользователи</h2>
    <a href="/User/Create" class="inline-block bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition mb-4">
        Добавить нового
    </a>

    <div class="overflow-x-auto">
        <table class="min-w-full bg-white border border-gray-300 rounded-lg shadow-sm">
            <thead class="bg-gray-100">
                <tr>
                    <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">ФИО</th>
                    <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Дата рождения</th>
                    <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var user in Model)
                    {
                        <tr class="border-b hover:bg-gray-50">
                            <td class="px-4 py-2 text-sm">@user.FullName</td>
                            <td class="px-4 py-2 text-sm">@user.BirthDate.ToShortDateString()</td>
                            <td class="px-4 py-2 text-sm space-x-2">
                                <a href="/User/Edit/@user.Id" class="text-blue-600 hover:underline">Редактировать</a>
                                <a href="/User/Delete/@user.Id" class="text-red-600 hover:underline">Удалить</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="px-4 py-4 text-center text-gray-500">Нет пользователей</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>